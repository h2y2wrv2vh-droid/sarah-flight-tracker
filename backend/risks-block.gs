function getRisks(p) {
  var dest = String(p.dest || '').trim().toUpperCase();
  var iso3 = IATA_COUNTRY[dest] || '';
  var countryName = '';
  var result = {ok: true, dest: dest, iso3: iso3, country: '', safety: null,
    advisories: {}, seasonal: [], disasters: [], degraded: []};

  // --- safety scores + advisories (isitsafetotravel.org, cached 6h) ---
  try {
    var scores = fetchSafetyScores();
    if (scores && iso3) {
      var list = scores.countries || [];
      for (var i = 0; i < list.length; i++) {
        if (list[i].iso3 === iso3) {
          var c = list[i];
          countryName = c.name || iso3;
          result.country = countryName;
          result.safety = {score: c.score};
          if (c.us) result.advisories.us = c.us;
          if (c.ca) result.advisories.ca = c.ca;
          break;
        }
      }
    }
  } catch (err) { result.degraded.push('safety'); }

  // --- active natural disasters (GDACS, cached 1h) ---
  try {
    var events = fetchGdacsEvents();
    var hits = [];
    for (var j = 0; j < events.length && hits.length < 6; j++) {
      var ev = events[j];
      for (var k = 0; k < ev.countries.length; k++) {
        var key = String(ev.countries[k]).toLowerCase().replace(/&amp;/g, '&').trim();
        if (COUNTRY_NAME_ISO3[key] === iso3) { hits.push(ev); break; }
      }
    }
    result.disasters = hits;
  } catch (err) { result.degraded.push('disasters'); }

  // --- seasonal weather risks for the trip dates ---
  try {
    var months = monthsInRange(p.departDate, p.returnDate);
    var table = SEASONAL_RISKS[dest] || (iso3 ? SEASONAL_RISKS[iso3] : null) || [];
    var seen = {};
    for (var m = 0; m < table.length; m++) {
      var r = table[m];
      var active = false;
      for (var n = 0; n < months.length; n++) {
        if (r.months.indexOf(months[n]) !== -1) { active = true; break; }
      }
      var sig = r.title + '|' + r.detail;
      if (active && !seen[sig]) { seen[sig] = 1; result.seasonal.push({title: r.title, detail: r.detail, severity: r.severity}); }
    }
  } catch (err) { result.degraded.push('seasonal'); }

  return result;
}

function monthsInRange(dep, ret) {
  var out = [];
  try {
    var d1 = new Date(String(dep).substring(0, 10) + 'T12:00:00');
    var d2 = new Date(String(ret || dep).substring(0, 10) + 'T12:00:00');
    if (isNaN(d1.getTime())) return [];
    if (isNaN(d2.getTime()) || d2 < d1) d2 = d1;
    var cur = new Date(d1.getFullYear(), d1.getMonth(), 1);
    var end = new Date(d2.getFullYear(), d2.getMonth(), 1);
    while (cur <= end) { out.push(cur.getMonth() + 1); cur = new Date(cur.getFullYear(), cur.getMonth() + 1, 1); }
  } catch (e) {}
  return out;
}

function fetchSafetyScores() {
  var cache = CacheService.getScriptCache();
  var hit = cache.get('safety_scores');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var resp = UrlFetchApp.fetch('https://isitsafetotravel.org/scores.json', {muteHttpExceptions: true});
  if (resp.getResponseCode() !== 200) throw new Error('scores fetch failed');
  var full = JSON.parse(resp.getContentText());
  var slim = {countries: []};
  for (var i = 0; i < full.countries.length; i++) {
    var c = full.countries[i];
    var adv = c.advisories || {};
    slim.countries.push({iso3: c.iso3, name: c.name.en,
      score: (c.scoreDisplay != null ? c.scoreDisplay : Math.round(c.score)),
      us: adv.us ? {level: adv.us.level, text: adv.us.text, url: adv.us.url} : null,
      ca: adv.ca ? {level: adv.ca.level, text: adv.ca.text, url: adv.ca.url} : null});
  }
  try { cache.put('safety_scores', JSON.stringify(slim), 21600); } catch (e) {}
  return slim;
}

function slimCountry(c) {
  return {iso3: c.iso3, country: c.name, safety: c.score,
    us: c.us, ca: c.ca};
}

function fetchGdacsEvents() {
  var cache = CacheService.getScriptCache();
  var hit = cache.get('gdacs_events');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var resp = UrlFetchApp.fetch('https://www.gdacs.org/xml/rss.xml', {muteHttpExceptions: true});
  if (resp.getResponseCode() !== 200) throw new Error('gdacs fetch failed');
  var doc = XmlService.parse(resp.getContentText());
  var root = doc.getRootElement();
  var channel = root.getChild('channel');
  var items = channel.getChildren('item');
  var gdacsNs = XmlService.getNamespace('gdacs', 'http://www.gdacs.org');
  var events = [];
  for (var i = 0; i < items.length && i < 60; i++) {
    var it = items[i];
    var titleEl = it.getChild('title');
    var linkEl = it.getChild('link');
    var pubEl = it.getChild('pubDate');
    var cEl = it.getChild('country', gdacsNs);
    var countries = [];
    if (cEl) {
      var parts = cEl.getText().split(',');
      for (var k = 0; k < parts.length; k++) {
        var nm = parts[k].trim();
        if (nm) countries.push(nm);
      }
    }
    events.push({
      title: titleEl ? titleEl.getText() : '',
      link: linkEl ? linkEl.getText() : '',
      pubDate: pubEl ? pubEl.getText() : '',
      countries: countries
    });
  }
  try { cache.put('gdacs_events', JSON.stringify(events).substring(0, 95000), 3600); } catch (e) {}
  return events;
}
